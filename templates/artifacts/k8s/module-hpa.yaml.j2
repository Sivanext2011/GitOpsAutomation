apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ module.name }}
  labels:
    app.kubernetes.io/part-of: {{ config.slug }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ module.name }}
  minReplicas: {{ config.replicas }}
  maxReplicas: 6
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
