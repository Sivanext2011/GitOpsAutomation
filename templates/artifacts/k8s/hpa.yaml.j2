apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ config.slug }}
  namespace: {{ config.namespace }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ config.slug }}
  minReplicas: {{ config.replicas }}
  maxReplicas: 6
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70

