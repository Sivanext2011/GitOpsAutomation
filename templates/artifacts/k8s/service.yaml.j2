apiVersion: v1
kind: Service
metadata:
  name: {{ config.slug }}
  namespace: {{ config.namespace }}
  labels:
    app.kubernetes.io/name: {{ config.slug }}
spec:
  type: LoadBalancer
  selector:
    app.kubernetes.io/name: {{ config.slug }}
  ports:
    - name: http
      port: 80
      targetPort: {{ config.app_port }}

